rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function family(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return signedIn()
        && currentUser().data.familyId == familyId
        && family(familyId).data.members.hasAny([request.auth.uid]);
    }

    function isFamilyOwner(familyId) {
      return isFamilyMember(familyId)
        && family(familyId).data.ownerId == request.auth.uid;
    }

    function isFamilyApprover(familyId) {
      return isFamilyOwner(familyId)
        || (
          isFamilyMember(familyId)
          && family(familyId).data.get('rewardApproverIds', [])
            .hasAny([request.auth.uid])
        );
    }

    // Digital Rewards run directly through Firestore on the project's Spark
    // plan. Keep the local catalog honest at the data boundary: a client can
    // create only a known reward, at its canonical price/category/asset, while
    // atomically debiting that exact number of Tokens.
    function digitalRewardCost(rewardId) {
      return rewardId == 'frame_gold' ? 250
        : rewardId == 'frame_neon' ? 320
        : rewardId == 'frame_ocean' ? 280
        : rewardId == 'badge_champion' ? 180
        : rewardId == 'badge_explorer' ? 150
        : rewardId == 'badge_family_star' ? 200
        : rewardId == 'theme_galaxy' ? 420
        : rewardId == 'theme_ocean' ? 380
        : rewardId == 'theme_sunset' ? 400
        : rewardId == 'celebration_confetti' ? 350
        : rewardId == 'celebration_fireworks' ? 450
        : rewardId == 'celebration_stars' ? 320
        : rewardId == 'nameplate_gold' ? 220
        : rewardId == 'nameplate_neon' ? 240
        : rewardId == 'nameplate_champion' ? 300
        : rewardId == 'mascot_guardian_crown' ? 300
        : rewardId == 'mascot_explorer_cap' ? 240
        : rewardId == 'mascot_star_halo' ? 380
        : rewardId == 'mascot_family_cape' ? 320
        : rewardId == 'mascot_game_jersey' ? 280
        : rewardId == 'mascot_memory_keeper' ? 340
        : rewardId == 'mascot_family_sparkles' ? 260
        : rewardId == 'mascot_cosmic_orbit' ? 420
        : rewardId == 'mascot_uae_ribbon' ? 360
        : rewardId == 'mascot_family_leaf_wreath' ? 290
        : rewardId == 'mascot_scholar_cap' ? 420
        : rewardId == 'mascot_space_scout' ? 390
        : rewardId == 'mascot_desert_explorer' ? 310
        : rewardId == 'mascot_memory_hearts' ? 330
        : rewardId == 'mascot_victory_burst' ? 460
        : -1;
    }

    function digitalRewardCategory(rewardId) {
      return rewardId in ['frame_gold', 'frame_neon', 'frame_ocean']
          ? 'profileFrame'
        : rewardId in ['badge_champion', 'badge_explorer', 'badge_family_star']
          ? 'profileBadge'
        : rewardId in ['theme_galaxy', 'theme_ocean', 'theme_sunset']
          ? 'profileTheme'
        : rewardId in [
            'celebration_confetti',
            'celebration_fireworks',
            'celebration_stars'
          ] ? 'celebrationEffect'
        : rewardId in ['nameplate_gold', 'nameplate_neon', 'nameplate_champion']
          ? 'nameplate'
        : rewardId in [
            'mascot_guardian_crown',
            'mascot_explorer_cap',
            'mascot_star_halo',
            'mascot_family_leaf_wreath',
            'mascot_scholar_cap'
          ] ? 'mascotAccessory'
        : rewardId in [
            'mascot_family_cape',
            'mascot_game_jersey',
            'mascot_memory_keeper',
            'mascot_space_scout',
            'mascot_desert_explorer'
          ] ? 'mascotOutfit'
        : rewardId in [
            'mascot_family_sparkles',
            'mascot_cosmic_orbit',
            'mascot_uae_ribbon',
            'mascot_memory_hearts',
            'mascot_victory_burst'
          ] ? 'mascotAura'
        : '';
    }

    function digitalRewardAsset(rewardId) {
      return rewardId == 'frame_gold' ? 'gold'
        : rewardId == 'frame_neon' ? 'neon'
        : rewardId == 'frame_ocean' ? 'ocean'
        : rewardId == 'badge_champion' ? 'champion'
        : rewardId == 'badge_explorer' ? 'explorer'
        : rewardId == 'badge_family_star' ? 'family_star'
        : rewardId == 'theme_galaxy' ? 'galaxy'
        : rewardId == 'theme_ocean' ? 'ocean'
        : rewardId == 'theme_sunset' ? 'sunset'
        : rewardId == 'celebration_confetti' ? 'confetti'
        : rewardId == 'celebration_fireworks' ? 'fireworks'
        : rewardId == 'celebration_stars' ? 'stars'
        : rewardId == 'nameplate_gold' ? 'gold'
        : rewardId == 'nameplate_neon' ? 'neon'
        : rewardId == 'nameplate_champion' ? 'champion'
        : rewardId == 'mascot_guardian_crown' ? 'guardian_crown'
        : rewardId == 'mascot_explorer_cap' ? 'explorer_cap'
        : rewardId == 'mascot_star_halo' ? 'star_halo'
        : rewardId == 'mascot_family_cape' ? 'family_cape'
        : rewardId == 'mascot_game_jersey' ? 'game_jersey'
        : rewardId == 'mascot_memory_keeper' ? 'memory_keeper'
        : rewardId == 'mascot_family_sparkles' ? 'family_sparkles'
        : rewardId == 'mascot_cosmic_orbit' ? 'cosmic_orbit'
        : rewardId == 'mascot_uae_ribbon' ? 'uae_ribbon'
        : rewardId == 'mascot_family_leaf_wreath' ? 'family_leaf_wreath'
        : rewardId == 'mascot_scholar_cap' ? 'scholar_cap'
        : rewardId == 'mascot_space_scout' ? 'space_scout'
        : rewardId == 'mascot_desert_explorer' ? 'desert_explorer'
        : rewardId == 'mascot_memory_hearts' ? 'memory_hearts'
        : rewardId == 'mascot_victory_burst' ? 'victory_burst'
        : '';
    }

    function digitalRewardIdFor(category, asset) {
      return category == 'profileFrame' && asset == 'gold' ? 'frame_gold'
        : category == 'profileFrame' && asset == 'neon' ? 'frame_neon'
        : category == 'profileFrame' && asset == 'ocean' ? 'frame_ocean'
        : category == 'profileBadge' && asset == 'champion' ? 'badge_champion'
        : category == 'profileBadge' && asset == 'explorer' ? 'badge_explorer'
        : category == 'profileBadge' && asset == 'family_star' ? 'badge_family_star'
        : category == 'profileTheme' && asset == 'galaxy' ? 'theme_galaxy'
        : category == 'profileTheme' && asset == 'ocean' ? 'theme_ocean'
        : category == 'profileTheme' && asset == 'sunset' ? 'theme_sunset'
        : category == 'celebrationEffect' && asset == 'confetti' ? 'celebration_confetti'
        : category == 'celebrationEffect' && asset == 'fireworks' ? 'celebration_fireworks'
        : category == 'celebrationEffect' && asset == 'stars' ? 'celebration_stars'
        : category == 'nameplate' && asset == 'gold' ? 'nameplate_gold'
        : category == 'nameplate' && asset == 'neon' ? 'nameplate_neon'
        : category == 'nameplate' && asset == 'champion' ? 'nameplate_champion'
        : category == 'mascotAccessory' && asset == 'guardian_crown' ? 'mascot_guardian_crown'
        : category == 'mascotAccessory' && asset == 'explorer_cap' ? 'mascot_explorer_cap'
        : category == 'mascotAccessory' && asset == 'star_halo' ? 'mascot_star_halo'
        : category == 'mascotAccessory' && asset == 'family_leaf_wreath' ? 'mascot_family_leaf_wreath'
        : category == 'mascotAccessory' && asset == 'scholar_cap' ? 'mascot_scholar_cap'
        : category == 'mascotOutfit' && asset == 'family_cape' ? 'mascot_family_cape'
        : category == 'mascotOutfit' && asset == 'game_jersey' ? 'mascot_game_jersey'
        : category == 'mascotOutfit' && asset == 'memory_keeper' ? 'mascot_memory_keeper'
        : category == 'mascotOutfit' && asset == 'space_scout' ? 'mascot_space_scout'
        : category == 'mascotOutfit' && asset == 'desert_explorer' ? 'mascot_desert_explorer'
        : category == 'mascotAura' && asset == 'family_sparkles' ? 'mascot_family_sparkles'
        : category == 'mascotAura' && asset == 'cosmic_orbit' ? 'mascot_cosmic_orbit'
        : category == 'mascotAura' && asset == 'uae_ribbon' ? 'mascot_uae_ribbon'
        : category == 'mascotAura' && asset == 'memory_hearts' ? 'mascot_memory_hearts'
        : category == 'mascotAura' && asset == 'victory_burst' ? 'mascot_victory_burst'
        : '';
    }

    function isUnequippedDigitalRewardAsset(category, asset) {
      return (
          category in [
            'profileBadge',
            'mascotAccessory',
            'mascotOutfit',
            'mascotAura'
          ] && asset in ['none', 'default']
        ) || (
          category in [
            'profileFrame',
            'profileTheme',
            'celebrationEffect',
            'nameplate'
          ] && asset == 'default'
        );
    }

    function ownsDigitalRewardAsset(userId, category, asset) {
      let rewardId = digitalRewardIdFor(category, asset);
      return isUnequippedDigitalRewardAsset(category, asset)
        || (
          rewardId != ''
          && existsAfter(
            /databases/$(database)/documents/users/$(userId)/ownedRewards/$(rewardId)
          )
        );
    }

    function validDigitalRewardSettingsChange(userId, changedKeys) {
      let data = request.resource.data;
      return changedKeys.hasOnly([
        'profileFrame',
        'profileBadge',
        'profileTheme',
        'celebrationEffect',
        'nameplate',
        'mascotAccessory',
        'mascotOutfit',
        'mascotAura',
        'updatedAt'
      ])
        && changedKeys.size() == 2
        && changedKeys.hasAny([
          'profileFrame',
          'profileBadge',
          'profileTheme',
          'celebrationEffect',
          'nameplate',
          'mascotAccessory',
          'mascotOutfit',
          'mascotAura'
        ])
        && data.updatedAt == request.time
        && (
          (
            changedKeys.hasAny(['profileFrame'])
            && ownsDigitalRewardAsset(
              userId,
              'profileFrame',
              data.profileFrame
            )
          ) || (
            changedKeys.hasAny(['profileBadge'])
            && ownsDigitalRewardAsset(
              userId,
              'profileBadge',
              data.profileBadge
            )
          ) || (
            changedKeys.hasAny(['profileTheme'])
            && ownsDigitalRewardAsset(
              userId,
              'profileTheme',
              data.profileTheme
            )
          ) || (
            changedKeys.hasAny(['celebrationEffect'])
            && ownsDigitalRewardAsset(
              userId,
              'celebrationEffect',
              data.celebrationEffect
            )
          ) || (
            changedKeys.hasAny(['nameplate'])
            && ownsDigitalRewardAsset(
              userId,
              'nameplate',
              data.nameplate
            )
          ) || (
            changedKeys.hasAny(['mascotAccessory'])
            && ownsDigitalRewardAsset(
              userId,
              'mascotAccessory',
              data.mascotAccessory
            )
          ) || (
            changedKeys.hasAny(['mascotOutfit'])
            && ownsDigitalRewardAsset(
              userId,
              'mascotOutfit',
              data.mascotOutfit
            )
          ) || (
            changedKeys.hasAny(['mascotAura'])
            && ownsDigitalRewardAsset(
              userId,
              'mascotAura',
              data.mascotAura
            )
          )
        );
    }

    function validDigitalRewardPurchase(userId, rewardId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let userBefore = get(userPath).data;
      let cost = digitalRewardCost(rewardId);
      return cost > 0
        && userBefore.familyId != null
        && family(userBefore.familyId).data.members.hasAny([userId])
        && userBefore.tokens >= cost
        && getAfter(userPath).data.tokens == userBefore.tokens - cost
        && getAfter(userPath).data.lastDigitalRewardPurchase == rewardId
        && request.resource.data.keys().hasAll([
          'rewardId',
          'name',
          'description',
          'cost',
          'category',
          'assetKey',
          'previewAsset',
          'purchasedAt',
          'equipped'
        ])
        && request.resource.data.keys().hasOnly([
          'rewardId',
          'name',
          'description',
          'cost',
          'category',
          'assetKey',
          'previewAsset',
          'purchasedAt',
          'equipped'
        ])
        && request.resource.data.rewardId == rewardId
        && request.resource.data.name is string
        && request.resource.data.description is string
        && request.resource.data.cost == cost
        && request.resource.data.category == digitalRewardCategory(rewardId)
        && request.resource.data.assetKey == digitalRewardAsset(rewardId)
        && request.resource.data.previewAsset == 'builtIn:' + rewardId
        && request.resource.data.purchasedAt == request.time
        && request.resource.data.equipped is bool;
    }

    function joinsFamilyWithOnlySelf() {
      return signedIn()
        && currentUser().data.familyId == null
        && !resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members']);
    }

    function leavesFamilyWithOnlySelf() {
      let oldApprovers = resource.data.get('rewardApproverIds', []);
      let newApprovers = request.resource.data.get('rewardApproverIds', []);

      return signedIn()
        && resource.data.ownerId != request.auth.uid
        && resource.data.members.hasAny([request.auth.uid])
        && !request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members.hasOnly(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && newApprovers.hasOnly(oldApprovers)
        && !newApprovers.hasAny([request.auth.uid])
        && (
          (
            oldApprovers.hasAny([request.auth.uid])
            && newApprovers.size() == oldApprovers.size() - 1
          )
          || (
            !oldApprovers.hasAny([request.auth.uid])
            && newApprovers.size() == oldApprovers.size()
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'rewardApproverIds']);
    }

    function familyOwnerClearsMembership() {
      return signedIn()
        && resource.data.familyId != null
        && family(resource.data.familyId).data.ownerId == request.auth.uid
        && request.resource.data.familyId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'familyId',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create: if isSelf(userId)
        && request.resource.data.familyId == null
        && request.resource.data.tokens == 0
        && request.resource.data.rankingPoints == 0;

      allow read: if isSelf(userId)
        || (
          signedIn()
          && resource.data.familyId != null
          && resource.data.familyId == currentUser().data.familyId
        );

      allow update: if isSelf(userId)
        || familyOwnerClearsMembership()
        || (
          signedIn()
          && resource.data.familyId != null
          && resource.data.familyId == currentUser().data.familyId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'tokens',
            'rankingPoints',
            'officialWins',
            'dailyWins',
            'weeklyWins',
            'monthlyWins',
            'gamesPlayed',
            'trophies',
            'missionsCompleted',
            'updatedAt'
          ])
        );

      allow delete: if isSelf(userId);

      match /tokenTransactions/{transactionId} {
        allow read: if isSelf(userId)
          || (
            signedIn()
            && get(/databases/$(database)/documents/users/$(userId))
              .data.familyId == currentUser().data.familyId
          );
        allow create: if signedIn()
          && get(/databases/$(database)/documents/users/$(userId))
            .data.familyId == currentUser().data.familyId
          && request.resource.data.userId == userId
          && request.resource.data.familyId == currentUser().data.familyId;
        allow update, delete: if false;
      }

      match /ownedRewards/{rewardId} {
        allow read: if isSelf(userId)
          || (
            signedIn()
            && get(/databases/$(database)/documents/users/$(userId))
              .data.familyId == currentUser().data.familyId
          );
        allow create: if isSelf(userId)
          && validDigitalRewardPurchase(userId, rewardId);
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['equipped'])
          && request.resource.data.equipped is bool;
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if isSelf(userId)
          || (
            signedIn()
            && get(/databases/$(database)/documents/users/$(userId))
              .data.familyId == currentUser().data.familyId
          );
        allow create: if isSelf(userId)
          && settingId == 'digitalRewards'
          && request.resource.data.keys().size() == 2
          && validDigitalRewardSettingsChange(
            userId,
            request.resource.data.keys()
          );
        allow update: if isSelf(userId)
          && settingId == 'digitalRewards'
          && validDigitalRewardSettingsChange(
            userId,
            request.resource.data.diff(resource.data).affectedKeys()
          );
        allow delete: if false;
      }

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if isSelf(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isSelf(userId);
        allow create: if signedIn()
          && request.resource.data.userId == userId
          && get(/databases/$(database)/documents/users/$(userId))
            .data.familyId == currentUser().data.familyId;
      }

      // Sila chat history is private and available only through the
      // authenticated backend, which also applies family checks and limits.
      match /silaChatMessages/{messageId} {
        allow read, create, update, delete: if false;
      }
    }

    match /families/{familyId} {
      // A family ID is also its invitation code, so direct reads support the
      // join flow. Collection listing remains restricted to family members.
      allow get: if signedIn();
      allow list: if isFamilyMember(familyId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members.size() == 1
        && request.resource.data.members.hasOnly([request.auth.uid]);
      allow update: if isFamilyOwner(familyId)
        || joinsFamilyWithOnlySelf()
        || leavesFamilyWithOnlySelf();
      allow delete: if isFamilyOwner(familyId);

      match /memories/{memoryId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isFamilyMember(familyId);
      }

      match /rewards/{rewardId} {
        allow read: if isFamilyMember(familyId);
        allow create, update, delete: if isFamilyOwner(familyId);
      }

      match /rewardWishlist/{suggestionId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.suggestedBy == request.auth.uid;
        allow update, delete: if isFamilyMember(familyId);
      }

      match /rewardWishlistProposals/{proposalId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.familyId == familyId
          && request.resource.data.requesterId == request.auth.uid
          && get(
            /databases/$(database)/documents/users/$(request.resource.data.recipientId)
          ).data.familyId == familyId;
        allow update: if isFamilyMember(familyId)
          && (
            resource.data.requesterId == request.auth.uid
            || resource.data.recipientId == request.auth.uid
          );
        allow delete: if false;
      }

      match /rewardRequests/{requestId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.familyId == familyId;
        allow update: if isFamilyApprover(familyId)
          || (
            isFamilyMember(familyId)
            && resource.data.userId == request.auth.uid
          );
        allow delete: if false;
      }

      match /rewardRequestLocks/{lockId} {
        allow read, create, update, delete: if isFamilyMember(familyId);
      }

      match /rewardRedemptionLocks/{lockId} {
        allow read, create, update: if isFamilyMember(familyId);
        allow delete: if false;
      }

      match /missionBoards/{boardId} {
        allow read, create, update: if isFamilyMember(familyId);
        allow delete: if false;
      }

      match /missionCompletions/{completionId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.submittedBy == request.auth.uid
          && request.resource.data.familyId == familyId
          && request.resource.data.proofRetained == false;
        allow update, delete: if false;
      }

      match /officialCompetitions/{competitionId} {
        allow read, create, update: if isFamilyMember(familyId);
        allow delete: if isFamilyOwner(familyId);
      }

      match /trophies/{trophyId} {
        allow read, create: if isFamilyMember(familyId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
